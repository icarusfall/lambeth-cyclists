# Notion integration token (CycleBot integration)
NOTION_API_TOKEN=ntn_xxx

# Bearer token(s) a client sends when calling this server.
# REQUIRED: the server refuses to start over HTTP without at least one.
# Comma-separated, so each caller can hold its own key and any one can be
# rotated without breaking the others.
#
# The portal no longer needs a key: its chat page runs the same tools
# in-process via core.cyclebot. This is only for MCP clients.
MCP_API_KEY=some-mcp-client-key

# Railway sets this automatically
PORT=8000
