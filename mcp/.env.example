# Notion integration token (CycleBot integration)
NOTION_API_TOKEN=ntn_xxx

# Bearer token(s) the Anthropic API sends when calling this server.
# REQUIRED: the server refuses to start over HTTP without at least one.
# Comma-separated, so each caller can hold its own key and either can be
# rotated without breaking the other. Must include every value its callers
# send: the portal's MCP_API_KEY and the Vercel chat app's.
MCP_API_KEY=portal-key,cyclebot-key

# Railway sets this automatically
PORT=8000
